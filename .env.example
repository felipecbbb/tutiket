# ────────────────────────────────────────────────────────────────
# Core
# ────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────────
# Database — Neon Postgres
# Crear cuenta en https://neon.tech, copiar connection string
# ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host.neon.tech/db?sslmode=require

# ────────────────────────────────────────────────────────────────
# Auth — Better-Auth
# Generar secret con: openssl rand -base64 32
# ────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ────────────────────────────────────────────────────────────────
# Stripe (pagos principales)
# Test keys: https://dashboard.stripe.com/test/apikeys
# ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ────────────────────────────────────────────────────────────────
# Redsys (TPV español)
# Sandbox por defecto, cambiar a false en producción
# ────────────────────────────────────────────────────────────────
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=1
REDSYS_SECRET_KEY=
REDSYS_SANDBOX=true

# ────────────────────────────────────────────────────────────────
# Email — Resend
# API key: https://resend.com/api-keys
# ────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=notificaciones@tudominio.com

# ────────────────────────────────────────────────────────────────
# Storage — Cloudflare R2
# Crear bucket: https://dash.cloudflare.com → R2
# ────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# ────────────────────────────────────────────────────────────────
# Observabilidad
# ────────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
